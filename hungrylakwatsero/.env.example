# ============================================================
# HungryLakwatsero Frontend – Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.

# --- API Base URL ---
# In development: leave empty or set to http://localhost:5000
# In production:  set to your deployed backend URL (Render/Railway)
#   Example: https://hungrylakwatsero-api.onrender.com
VITE_API_URL=

# --- Demo Accounts (optional, for dev/testing only) ---
# Leave empty to hide demo login buttons in production.
# VITE_DEMO_TOURIST_EMAIL=tourist1@demo.com
# VITE_DEMO_OWNER_EMAIL=owner1@demo.com
# VITE_DEMO_ADMIN_EMAIL=admin@hungrylakwatsero.ph
# VITE_DEMO_PASSWORD=Admin@123!

# ============================================================
# HungryLakwatsero Backend – Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real secrets.

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Authentication (REQUIRED in production) ---
# Generate secure secrets:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- Database (leave empty for SQLite dev fallback) ---
# For MySQL production deployment (Railway / PlanetScale / Aiven):
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- CORS ---
# Comma-separated list of allowed origins.
# In development: http://localhost:3000
# In production:  https://your-frontend.vercel.app
CORS_ORIGIN=http://localhost:3000

# --- Uploads ---
# Cloudinary FREE tier (25GB storage, 25GB bandwidth/month)
# Leave empty to use local disk storage (dev only, not persistent in prod)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Base URL for uploaded files (used when frontend is on a different domain).
# In development: leave empty (uses relative paths)
# In production:  https://your-backend.onrender.com
UPLOAD_BASE_URL=

# --- API Server URL ---
# Public URL of this API server (used for Swagger docs etc.)
# In development: http://localhost:5000
# In production:  https://your-backend.onrender.com
API_BASE_URL=http://localhost:5000

# ============================================================
# Production deployment (Render / Railway):
#   Set NODE_ENV=production and fill in ALL required vars above.
#   Required: JWT_SECRET, JWT_REFRESH_SECRET, CORS_ORIGIN,
#             DB_HOST, DB_USER, DB_PASSWORD, DB_NAME
#   Recommended: UPLOAD_BASE_URL, API_BASE_URL
# ============================================================